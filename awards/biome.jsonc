{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        // React needs keys so it can reconcile a virtual DOM across renders. Hono JSX
        // renders to a string once, server-side; there is no reconciliation and no client
        // runtime, so a key here is noise with no behaviour attached.
        "useJsxKeyInIterable": "off"
      },
      "security": {
        // This rule exists to stop user input reaching innerHTML in a React app. There is
        // no React here, no client runtime at all, and the two uses on this site are a
        // constant stylesheet from this repository and JSON-LD serialized from our own
        // objects by serializeJsonLd, which escapes the one sequence that could close a
        // script element early. Hono JSX offers no other way to inline either. Left on, the
        // rule can only be suppressed per-use, and biome does not honour a `//` suppression
        // in JSX attribute position - so it would have to be silenced anyway, less visibly.
        "noDangerouslySetInnerHtml": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // The repository normalizes to LF (see .gitattributes); without this biome
    // reformats every file on a Windows checkout and the diff is the whole tree.
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "files": {
    // test/fixtures holds captured upstream responses. They are data, not source:
    // formatting them would break the byte-for-byte relationship with what the API
    // actually returned, and the parity fixture is larger than biome will parse.
    "ignore": [
      "node_modules",
      ".wrangler",
      "dist",
      "test/fixtures",
      // Generated by awards/scripts/generate_aliases.py from the Python YAML that is
      // the source of truth. Formatting it here would make the formatter and the
      // generator produce different bytes, and the drift test that guards the two
      // copies would then fail on every clean checkout.
      "src/analysis/aliases.ts"
    ]
  }
}
